{
  "scripts": {
    "install:all": "npm install --prefix campus-lost-found-backend && npm install --prefix campus-lost-found-frontend",
    "start:backend": "npm run dev --prefix campus-lost-found-backend",
    "start:frontend": "npm start --prefix campus-lost-found-frontend",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
